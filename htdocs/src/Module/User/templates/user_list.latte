{* The user list: htdocs/user/list.php l.675-1484. The data is escaped; the *Html fragments, the titles and the
	cells of $row['cells'] come from the legacy helpers (UserListChrome) and are output raw. *}
{layout 'core:@layout'}

{block content}
<form method="POST" id="searchFormList" action="{$formAction}">
{if $userSearch->optioncss !== ''}<input type="hidden" name="optioncss" value="{$userSearch->optioncss}">{/if}
<input type="hidden" name="token" value="{token()}">
<input type="hidden" name="formfilteraction" id="formfilteraction" value="list">
<input type="hidden" name="sortfield" value="{$userSearch->sortField}">
<input type="hidden" name="sortorder" value="{$userSearch->sortOrder}">
<input type="hidden" name="page" value="{$userSearch->page}">
<input type="hidden" name="contextpage" value="{$userSearch->contextpage}">
<input type="hidden" name="page_y" value="">
<input type="hidden" name="mode" value="{$userSearch->mode}">
{$titleBarHtml|noescape}
{if $search['search_all'] !== ''}<input type="hidden" name="search_all" value="{$search['search_all']}">{/if}
{$categoryWaysHtml|noescape}
{$searchAllHtml|noescape}
{if $moreForFilterHtml !== ''}
<div class="liste_titre liste_titre_bydiv centpercent">{$moreForFilterHtml|noescape}</div>
{/if}
<div class="div-table-responsive">
<table class="tagtable nobottomiftotal liste{if $moreForFilterHtml !== ''} listwithfilterbefore{/if}">
<tr class="liste_titre_filter">
{if $checkboxLeft}<td class="liste_titre center maxwidthsearch">{$widgets['buttonsLeft']|noescape}</td>{/if}
{if $show['u.rowid'] ?? false}<td class="liste_titre"><input type="text" name="search_rowid" class="maxwidth50" value="{$search['search_rowid']}"></td>{/if}
{if $show['u.login'] ?? false}<td class="liste_titre"><input type="text" name="search_login" class="maxwidth50" value="{$search['search_login']}"></td>{/if}
{if $show['u.lastname'] ?? false}<td class="liste_titre"><input type="text" name="search_lastname" class="maxwidth50" value="{$search['search_lastname']}"></td>{/if}
{if $show['u.firstname'] ?? false}<td class="liste_titre"><input type="text" name="search_firstname" class="maxwidth50" value="{$search['search_firstname']}"></td>{/if}
{if $show['u.gender'] ?? false}<td class="liste_titre center">{$widgets['gender']|noescape}</td>{/if}
{if $show['u.employee'] ?? false}<td class="liste_titre">{$widgets['employee']|noescape}</td>{/if}
{if $show['u.fk_user'] ?? false}<td class="liste_titre">{$widgets['supervisor']|noescape}</td>{/if}
{if $show['u.accountancy_code'] ?? false}<td class="liste_titre"><input type="text" name="search_accountancy_code" class="maxwidth50" value="{$search['search_accountancy_code']}"></td>{/if}
{if $show['u.office_phone'] ?? false}<td class="liste_titre"><input type="text" name="search_phonepro" class="maxwidth50" value="{$search['search_phonepro']}"></td>{/if}
{if $show['u.user_mobile'] ?? false}<td class="liste_titre"><input type="text" name="search_phonemobile" class="maxwidth50" value="{$search['search_phonemobile']}"></td>{/if}
{if $show['u.email'] ?? false}<td class="liste_titre"><input type="text" name="search_email" class="maxwidth75" value="{$search['search_email']}"></td>{/if}
{if $show['co.label'] ?? false}<td class="liste_titre">{$widgets['country']|noescape}</td>{/if}
{if $show['u.api_key'] ?? false}<td class="liste_titre"><input type="text" name="search_api_key" class="maxwidth50" value="{$search['search_api_key']}"></td>{/if}
{if $show['u.fk_soc'] ?? false}<td class="liste_titre"><input type="text" name="search_thirdparty" class="maxwidth75" value="{$search['search_thirdparty']}"></td>{/if}
{if $show['u.entity'] ?? false}<td class="liste_titre"></td>{/if}
{if $show['u.ref_employee'] ?? false}<td class="liste_titre"></td>{/if}
{if $show['u.national_registration_number'] ?? false}<td class="liste_titre"></td>{/if}
{if $show['u.job'] ?? false}<td class="liste_titre"><input type="text" name="search_job" class="maxwidth75" value="{$search['search_job']}"></td>{/if}
{if $show['u.salary'] ?? false}<td class="liste_titre"></td>{/if}
{if $show['u.thm'] ?? false}<td class="liste_titre"></td>{/if}
{if ($show['u.datelastlogin'] ?? false) && !$privacy}<td class="liste_titre"></td>{/if}
{if ($show['u.datepreviouslogin'] ?? false) && !$privacy}<td class="liste_titre"></td>{/if}
{$extraFieldsInputsHtml|noescape}
{$optionHookHtml|noescape}
{if $show['u.datec'] ?? false}<td class="liste_titre"></td>{/if}
{if $show['date_modification'] ?? false}<td class="liste_titre"></td>{/if}
{if $show['u.import_key'] ?? false}<td class="liste_titre"></td>{/if}
{if $show['u.statut'] ?? false}<td class="liste_titre center parentonrightofpage">{$widgets['status']|noescape}</td>{/if}
{if !$checkboxLeft}<td class="liste_titre maxwidthsearch">{$widgets['buttonsRight']|noescape}</td>{/if}
</tr>
<tr class="liste_titre">
{foreach $titlesBefore as $th}{$th|noescape}{/foreach}
{$titleHookHtml|noescape}
{foreach $titlesAfter as $th}{$th|noescape}{/foreach}
</tr>
{if $userSearch->mode === 'kanban'}
{if $rows !== []}
<tr class="trkanban"><td colspan="{$kanbanColspan}"><div class="box-flex-container kanban">
{foreach $rows as $row}{$row['kanbanHtml']|noescape}{/foreach}
</div></td></tr>
{/if}
{else}
{foreach $rows as $row}
{var $rowUser = $row['user']}
{var $cells = $row['cells']}
<tr data-rowid="{$rowUser->id}" class="oddeven row-with-select">
{if $checkboxLeft}<td class="nowrap center">{if $row['selected'] >= 0}<input id="cb{$rowUser->id}" class="flat checkforselect" type="checkbox" name="toselect[]" value="{$rowUser->id}"{if $row['selected'] === 1} checked="checked"{/if}>{/if}</td>{/if}
{if $show['u.rowid'] ?? false}<td class="nowraponall">{$rowUser->id}</td>{/if}
{if $show['u.login'] ?? false}<td class="nowraponall tdoverflowmax150">{$cells['login']|noescape}</td>{/if}
{* list.php l.1154-1161: the title of the first name cell is the last name *}
{if $show['u.lastname'] ?? false}<td class="tdoverflowmax150" title="{$rowUser->lastname}">{$rowUser->lastname}</td>{/if}
{if $show['u.firstname'] ?? false}<td class="tdoverflowmax150" title="{$rowUser->lastname}">{$rowUser->firstname}</td>{/if}
{if $show['u.gender'] ?? false}<td class="center">{if $rowUser->gender === 'man'}<i class="fas fa-mars" title="{='Genderman'|trans}"></i>{elseif $rowUser->gender === 'woman'}<i class="fas fa-venus" title="{='Genderwoman'|trans}"></i>{elseif $rowUser->gender === 'other'}<i class="fas fa-transgender" title="{='Genderother'|trans}"></i>{/if}</td>{/if}
{if $show['u.employee'] ?? false}<td class="center">{$cells['employee']|noescape}</td>{/if}
{if $show['u.fk_user'] ?? false}<td class="tdoverflowmax125">{$cells['supervisor']|noescape}</td>{/if}
{if $show['u.accountancy_code'] ?? false}<td>{$rowUser->accountancyCode}</td>{/if}
{if $show['u.office_phone'] ?? false}<td class="tdoverflowmax125">{$cells['phone']|noescape}</td>{/if}
{if $show['u.user_mobile'] ?? false}<td class="tdoverflowmax125">{$cells['mobile']|noescape}</td>{/if}
{if $show['u.email'] ?? false}<td class="tdoverflowmax150" title="{$rowUser->email}">{$cells['email']|noescape}</td>{/if}
{if $show['co.label'] ?? false}<td class="tdoverflowmax150">{$row['countryLabel']}</td>{/if}
{if $show['u.api_key'] ?? false}<td class="tdoverflowmax125" title="{$cells['apiKeyTitle']}">{$cells['apiKey']|noescape}</td>{/if}
{if $show['u.fk_soc'] ?? false}<td class="tdoverflowmax150">{$cells['company']|noescape}</td>{/if}
{if ($show['u.entity'] ?? false) && $cells['entity'] !== null}<td class="tdoverflowmax100" title="{$cells['entity']}">{$cells['entity']}</td>{/if}
{if $show['u.ref_employee'] ?? false}<td class="tdoverflowmax100" title="{$rowUser->refEmployee}">{$rowUser->refEmployee}</td>{/if}
{if $show['u.national_registration_number'] ?? false}<td class="tdoverflowmax100" title="{$rowUser->nationalRegistrationNumber}">{$rowUser->nationalRegistrationNumber}</td>{/if}
{if $show['u.job'] ?? false}<td class="tdoverflowmax100" title="{$rowUser->job}">{$rowUser->job}</td>{/if}
{if $show['u.salary'] ?? false}<td class="nowraponall right amount">{$cells['salary']|noescape}</td>{/if}
{if $show['u.thm'] ?? false}<td class="nowraponall right amount">{$cells['thm']|noescape}</td>{/if}
{if ($show['u.datelastlogin'] ?? false) && !$privacy}<td class="nowraponall center">{$cells['lastLogin']|noescape}</td>{/if}
{if ($show['u.datepreviouslogin'] ?? false) && !$privacy}<td class="nowraponall center">{$cells['previousLogin']|noescape}</td>{/if}
{$cells['extraFields']|noescape}
{$row['hookHtml']|noescape}
{if $show['u.datec'] ?? false}<td class="center nowraponall">{$cells['dateCreation']|noescape}</td>{/if}
{if $show['date_modification'] ?? false}<td class="center nowraponall">{$cells['dateModification']|noescape}</td>{/if}
{if $show['u.import_key'] ?? false}<td class="center">{$row['importKey']}</td>{/if}
{if $show['u.statut'] ?? false}<td class="center">{$cells['status']|noescape}</td>{/if}
{if !$checkboxLeft}<td class="nowrap center">{if $row['selected'] >= 0}<input id="cb{$rowUser->id}" class="flat checkforselect" type="checkbox" name="toselect[]" value="{$rowUser->id}"{if $row['selected'] === 1} checked="checked"{/if}>{/if}</td>{/if}
</tr>
{/foreach}
{/if}
{$totalsHtml|noescape}
{if $rows === []}
<tr><td colspan="{$colspan}"><span class="opacitymedium">{='NoRecordFound'|trans}</span></td></tr>
{/if}
{$footerHookHtml|noescape}
</table>
</div>
</form>
{/block}
